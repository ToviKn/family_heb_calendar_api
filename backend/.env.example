# -----------------------------------------------------------------------------
# Backend environment configuration
# -----------------------------------------------------------------------------
# LOCAL DOCKER COMPOSE (default): use the Docker network hostname "db" from
# docker-compose.yml so the API container connects to the local Postgres service.
DATABASE_URL=postgresql+psycopg://family_user:change-me-local-only@db:5432/family_calendar

# PRODUCTION (optional): Neon/hosted Postgres example (keep commented locally).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST.neon.tech:5432/DB_NAME?sslmode=require

JWT_SECRET_KEY=replace-with-a-strong-random-secret
ALLOWED_ORIGINS=https://your-frontend.example.com
ENV=production

# Optional
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
ENABLE_API_DOCS=false
RUN_LEGACY_STARTUP_MIGRATIONS=false
RUN_CREATE_ALL_IN_DEV=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Local Docker Compose (development only)
POSTGRES_USER=family_user
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=family_calendar
VITE_API_BASE_URL=http://localhost:8000
