# Database

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

# Authentication

JWT_SECRET_KEY=replace-with-a-strong-random-secret

# Frontend

ALLOWED_ORIGINS=https://your-frontend.example.com

# Environment

ENV=development
DEBUG=true
ENABLE_API_DOCS=true

# Optional

ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING

# Development-only settings

RUN_LEGACY_STARTUP_MIGRATIONS=true
RUN_CREATE_ALL_IN_DEV=false

# Database pool settings

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Local Docker Compose example

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# Production example

# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# ALLOWED_ORIGINS=https://your-frontend.example.com
# ENV=production
# DEBUG=false
# ENABLE_API_DOCS=false
# Notification delivery

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=admin@example.com

# SMTP

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Family Calendar <calendar@example.com>

# ----------

# Resend

#EMAIL_PROVIDER=resend
#RESEND_API_KEY=
#EMAIL_FROM=Family Calendar <onboarding@resend.dev>
RESEND_API_URL=https://api.resend.com/emails

# Brevo

EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM=Family Calendar <familycalendar.hebrew@gmail.com>
