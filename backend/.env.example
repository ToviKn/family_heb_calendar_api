# -----------------------------------------------------------------------------
# Local Docker development defaults
# -----------------------------------------------------------------------------
# Important: inside Docker Compose, backend connects to Postgres via hostname
# "db" (the compose service name), not localhost.
DATABASE_URL=postgresql+psycopg://family_user:family_calendar@db:5432/family_calendar

POSTGRES_USER=family_user
POSTGRES_PASSWORD=family_calendar
POSTGRES_DB=family_calendar

JWT_SECRET_KEY=local-dev-secret
ALLOWED_ORIGINS=http://localhost:5173

ENV=development
DEBUG=true
ENABLE_API_DOCS=true

# Optional local tuning
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
RUN_LEGACY_STARTUP_MIGRATIONS=true
RUN_CREATE_ALL_IN_DEV=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Optional production example (Neon/hosted Postgres) - keep commented locally.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST.neon.tech:5432/DB_NAME?sslmode=require
# ENV=production
# DEBUG=false
# ENABLE_API_DOCS=false
# ALLOWED_ORIGINS=https://your-frontend.example.com
# -----------------------------------------------------------------------------
